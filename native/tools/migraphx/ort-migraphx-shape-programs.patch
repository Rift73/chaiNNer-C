+// A fused node keeps the compiled programs of its most recently used input shapes, so inputs that alternate between
+// a few shapes (tiles and their edge tiles) compile each shape once per session. Every program holds its own copy of
+// the weights on the GPU, hence the bound; the least recently used program is dropped first.
+constexpr std::size_t kMaxProgramsPerNode = 4;
+
+void remember_program(MIGraphXFuncState& state, const std::string& shape_key, const migraphx::program& prog) {
+  auto& order = state.program_order;
+  order.erase(std::remove(order.begin(), order.end(), shape_key), order.end());
+  order.push_back(shape_key);
+  state.programs_by_shape.insert_or_assign(shape_key, prog);
+  if (order.size() > kMaxProgramsPerNode) {
+    state.programs_by_shape.erase(order.front());
+    order.erase(order.begin());
+  }
+}
