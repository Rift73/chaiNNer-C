MIGraphX provider: the compiled-program cache (.mxr) is named after the real input shapes.

make_hash passed the element count of a std::vector<int64_t> to MurmurHash3::x86_128, which takes a length in
bytes, so only the first bytes of the first dimension were hashed and every input shape got the same file name;
with migraphx_model_cache_dir set, a second input shape loaded the program compiled for the first one. The hash now
covers all bytes (string hashes are unchanged). At run time the name is built from every input's name and
dimensions in name order (the dynamic-shape branch used to hash an empty list, and the two branches visited the
inputs in different orders).

diff --git a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
index 8908013..4074b2f 100644
--- a/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
+++ b/onnxruntime/core/providers/migraphx/migraphx_execution_provider.cc
@@ -1284,7 +1284,7 @@ std::string to_hex(const uint64_t v) {
 template <typename T>
 std::string make_hash(T v) {
   std::array<std::uint32_t, 4> temp{};
-  MurmurHash3::x86_128(v.data(), gsl::narrow_cast<int32_t>(v.size()), temp[0], temp.data());
+  MurmurHash3::x86_128(v.data(), gsl::narrow_cast<int32_t>(v.size() * sizeof(*v.data())), temp[0], temp.data());
   return to_hex(temp[0] | static_cast<uint64_t>(temp[1]) << 32);
 }
 
@@ -1293,6 +1293,20 @@ std::string make_hash(const char* v) {
   return make_hash(std::string_view{v});
 }
 
+// One string per set of input shapes: each input's name (length-prefixed) and dimensions, in name order, so equal
+// shapes always give the same key whichever order the inputs were visited in.
+std::string make_shape_key(const std::map<std::string, std::vector<std::int64_t>>& input_shapes) {
+  std::string key;
+  for (const auto& [name, dims] : input_shapes) {
+    key += std::to_string(name.size()) + ':' + name;
+    for (auto d : dims) {
+      key += ',' + std::to_string(d);
+    }
+    key += ';';
+  }
+  return key;
+}
