# Minimal type stubs for the parts of tensorrt.plugin (TensorRT's Python plugin API)
# that chaiNNer uses (nodes/impl/tensorrt/dual_aot.py, tfix_aot.py).

from typing import Any, Callable, TypeVar

from . import DataType, TensorFormat

_F = TypeVar("_F", bound=Callable[..., Any])

class ShapeExpr:
    @property
    def is_constant(self) -> bool: ...
    def constant_value(self) -> int: ...
    def __add__(self, other: ShapeExpr | int) -> ShapeExpr: ...
    def __sub__(self, other: ShapeExpr | int) -> ShapeExpr: ...
    def __mul__(self, other: ShapeExpr | int) -> ShapeExpr: ...
    def __floordiv__(self, other: ShapeExpr | int) -> ShapeExpr: ...

class ShapeExprs:
    def __getitem__(self, index: int) -> ShapeExpr: ...
    def numel(self) -> ShapeExpr: ...

class TensorDesc:
    shape_expr: ShapeExprs
    dtype: DataType
    format: TensorFormat
    def like(self) -> TensorDesc: ...

class KernelLaunchParams:
    grid_x: int | ShapeExpr
    grid_y: int | ShapeExpr
    grid_z: int | ShapeExpr
    block_x: int
    shared_mem: int

class SymInt32:
    def __init__(self, value: int | ShapeExpr) -> None: ...

def cdiv(first: ShapeExpr | int, second: ShapeExpr | int) -> ShapeExpr: ...
def max(first: ShapeExpr | int, second: ShapeExpr | int) -> ShapeExpr: ...

class SymExprs: ...

class SymIntExprs(SymExprs):
    def __init__(self, count: int) -> None: ...
    def __setitem__(self, index: int, value: SymInt32) -> None: ...

def register(plugin_id: str, lazy_register: bool = False) -> Callable[[_F], _F]: ...
def aot_impl(plugin_id: str) -> Callable[[_F], _F]: ...
def autotune(plugin_id: str) -> Callable[[_F], _F]: ...

class AutoTuneCombination:
    def __init__(
        self, io_types: str, layouts: str = "LINEAR", tactics: list[int] | None = None
    ) -> None: ...

def from_shape_expr(
    shape_expr: tuple[ShapeExpr | int, ...], dtype: DataType
) -> TensorDesc: ...

op: Any
